<title>Portofolio - Namrin</title>
<style>
  :root{
    --biru:#2563eb; --abu:#f8fafc; --teks:#1e293b;
  }
  *{margin:0;padding:0;box-sizing:border-box;font-family: 'Poppins', sans-serif;}
  body{background:var(--abu); color:var(--teks); line-height:1.7;}
  .container{max-width:1000px;margin:auto;padding:20px;}
  
  /* Header */
  header{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:white;padding:60px 20px;text-align:center;border-radius:0 0 30px 30px;}
  header img{width:150px;height:150px;border-radius:50%;border:4px solid white;object-fit:cover;margin-bottom:15px;}
  header h1{font-size:2.5rem;margin-bottom:5px;}
  header p{opacity:0.9;}
  .kontak a{color:white;margin:0 10px;text-decoration:none;}

  /* Section */
  section{background:white;margin:30px 0;padding:30px;border-radius:15px;box-shadow:0 4px 15px rgba(0,0,0,0.05);}
  section h2{color:var(--biru);margin-bottom:15px;border-left:4px solid var(--biru);padding-left:10px;}

  /* Skills */
  .skills{display:flex;flex-wrap:wrap;gap:10px;}
  .skill{background:var(--abu);padding:8px 15px;border-radius:20px;font-size:0.9rem;}

  /* Galeri */
  .galeri{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:15px;}
  .galeri img{width:100%;height:220px;object-fit:cover;border-radius:12px;transition:0.3s;}
  .galeri img:hover{transform:scale(1.03);}

  /* Timeline */
  .item{margin-bottom:20px;padding-left:15px;border-left:2px solid #e2e8f0;}
  .item h3{font-size:1.1rem;color:#0f172a;}
  .item span{font-size:0.85rem;color:#64748b;}

  footer{text-align:center;padding:30px;color:#64748b;font-size:0.9rem;}
</style>
</head>
